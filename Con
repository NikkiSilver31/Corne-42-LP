config/corne.conf
ini
# Enable ZMK Studio support
CONFIG_ZMK_STUDIO=y

# Boost Bluetooth signal strength between keyboard halves
CONFIG_BT_CTLR_TX_PWR_PLUS_8=y

# Enter deep sleep after 15 minutes of inactivity (900,000 ms)
CONFIG_ZMK_SLEEP=y
CONFIG_ZMK_IDLE_SLEEP_TIMEOUT=900000

# Enable mouse key support
CONFIG_ZMK_POINTING=y
